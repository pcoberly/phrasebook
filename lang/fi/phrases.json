{
  "hello": {"text": "Hei", "say": "hey", "note": "For anyone, at any time. Moi (moy) is even more casual"},
  "how-are-you": {"text": "Mitä kuuluu?", "say": "MI-tä KOO-loo", "note": "Literally \"what is heard?\" Finns answer honestly, so ask only if you'd like to know"},
  "im-well": {"text": "Hyvää, kiitos!", "say": "HÜ-vää, KEE-tos"},
  "good-morning": {"text": "Hyvää huomenta", "say": "HÜ-vää HUO-men-ta"},
  "good-night": {"text": "Hyvää yötä", "say": "HÜ-vää ÜÖ-tä", "note": "Only when parting at night"},
  "goodbye": {"text": "Näkemiin", "say": "NÄ-ke-meen", "note": "Hei hei (hey hey) is the everyday goodbye"},
  "please": {"text": "Kiitos", "say": "KEE-tos", "note": "Finnish has no everyday please: kiitos, thanks, at the end of a request does the job"},
  "thank-you": {"text": "Kiitos", "say": "KEE-tos", "note": "Kiitos paljon (PAL-yon) means thank you very much"},
  "youre-welcome": {"text": "Ole hyvä", "say": "O-le HÜ-vä", "note": "Also here you are"},
  "yes": {"text": "Kyllä", "say": "KÜL-lä", "note": "Joo (yoo) is the everyday yes"},
  "no": {"text": "Ei", "say": "ey", "note": "Ei kiitos is no, thank you"},
  "excuse-me": {"text": "Anteeksi", "say": "AN-teek-si", "note": "Sorry, and excuse me to get attention or get past"},
  "my-name": {"text": "Nimeni on...", "say": "NI-me-ni on ...", "note": "The audio uses Peter as the example name", "spoken": "Nimeni on Peter", "filled": "Nimeni on ⟦Peter⟧"},
  "your-name": {"text": "Mikä sinun nimesi on?", "say": "MI-kä SI-nun NI-me-si on", "note": "Finns use sinä, the everyday you, with almost everyone"},
  "where-from": {"text": "Mistä olet kotoisin?", "say": "MIS-tä O-let KO-toi-sin"},
  "its-beautiful": {"text": "Tämä on kaunista!", "say": "TÄ-mä on KAU-nis-ta"},
  "dont-understand": {"text": "En ymmärrä", "say": "en ÜM-mär-rä", "note": "Finnish has no he or she, and no men's and women's forms"},
  "speak-slowly": {"text": "Voisitko puhua hitaammin?", "say": "VOI-sit-ko PU-hu-a HI-taam-min"},
  "repeat": {"text": "Voisitko toistaa?", "say": "VOI-sit-ko TOIS-taa"},
  "speak-english": {"text": "Puhutko englantia?", "say": "PU-hut-ko ENG-lan-ti-a", "note": "Most Finns speak good English"},

  "one": {"text": "Yksi", "say": "ÜK-si"},
  "two": {"text": "Kaksi", "say": "KAK-si"},
  "three": {"text": "Kolme", "say": "KOL-me"},
  "four": {"text": "Neljä", "say": "NEL-yä"},
  "five": {"text": "Viisi", "say": "VEE-si"},
  "six": {"text": "Kuusi", "say": "KOO-si"},
  "seven": {"text": "Seitsemän", "say": "SEIT-se-män"},
  "eight": {"text": "Kahdeksan", "say": "KAH-dek-san"},
  "nine": {"text": "Yhdeksän", "say": "ÜH-dek-sän"},
  "ten": {"text": "Kymmenen", "say": "KÜM-me-nen"},
  "hundred": {"text": "Sata", "say": "SA-ta"},
  "thousand": {"text": "Tuhat", "say": "TU-hat", "note": "Prices are in euros"},
  "hundred-thousand": {"text": "Satatuhatta", "say": "SA-ta-tu-hat-ta"},
  "million": {"text": "Miljoona", "say": "MIL-yoo-na"},

  "how-much": {"text": "Paljonko tämä maksaa?", "say": "PAL-yon-ko TÄ-mä MAK-saa"},
  "would-like": {"text": "Saisinko...?", "say": "SAI-sin-ko ...", "note": "Literally \"could I get...?\", the polite way to order. The audio uses kahvin (KAH-vin), a coffee", "spoken": "Saisinko kahvin?", "filled": "Saisinko ⟦kahvin⟧?"},
  "i-want": {"text": "Haluan...", "say": "HA-lu-an ...", "note": "More direct. The audio uses tämän (TÄ-män), this one", "spoken": "Haluan tämän", "filled": "Haluan ⟦tämän⟧"},
  "do-you-have": {"text": "Onko teillä...?", "say": "ON-ko TEIL-lä ...", "note": "The audio uses vettä (VET-tä), water", "spoken": "Onko teillä vettä?", "filled": "Onko teillä ⟦vettä⟧?"},
  "just-looking": {"text": "Katselen vain", "say": "KAT-se-len vain"},
  "ill-take-it": {"text": "Otan tämän", "say": "O-tan TÄ-män"},
  "too-expensive": {"text": "Liian kallis", "say": "LEE-an KAL-lis"},
  "discount": {"text": "Saako alennusta?", "say": "SAA-ko A-len-nus-ta", "note": "Prices are fixed in shops"},
  "card": {"text": "Voinko maksaa kortilla?", "say": "VOIN-ko MAK-saa KOR-til-la", "note": "Cards and phones are taken almost everywhere"},
  "bill": {"text": "Saisinko laskun?", "say": "SAI-sin-ko LAS-kun", "note": "Service is included; tipping isn't expected"},

  "reservation": {"text": "Minulla on varaus", "say": "MI-nul-la on VA-raus"},
  "checkout-time": {"text": "Milloin pitää lähteä?", "say": "MIL-loin PI-tää LÄH-te-ä", "note": "Literally \"when must I leave?\""},
  "breakfast": {"text": "Kuuluuko aamiainen hintaan?", "say": "KOO-loo-ko AA-mi-ai-nen HIN-taan"},
  "wifi": {"text": "Mikä on wifin salasana?", "say": "MI-kä on WI-fin SA-la-sa-na"},

  "toilet": {"text": "Missä on vessa?", "say": "MIS-sä on VES-sa", "note": "Missä (MIS-sä) means where"},
  "taxi": {"text": "Voisitteko tilata taksin?", "say": "VOI-sit-te-ko TI-la-ta TAK-sin"},
  "train": {"text": "Juna", "say": "YU-na"},
  "bus": {"text": "Bussi", "say": "BUS-si"},
  "airport": {"text": "Lentokenttä", "say": "LEN-to-kent-tä"},
  "bus-station": {"text": "Linja-autoasema", "say": "LIN-ya-au-to-a-se-ma"},
  "train-station": {"text": "Rautatieasema", "say": "RAU-ta-ti-e-a-se-ma"},
  "where-train-station": {"text": "Missä on rautatieasema?", "say": "MIS-sä on RAU-ta-ti-e-a-se-ma"},
  "where-bus-station": {"text": "Missä on linja-autoasema?", "say": "MIS-sä on LIN-ya-au-to-a-se-ma"},
  "which-train": {"text": "Mikä juna menee...?", "say": "MI-kä YU-na ME-nee ...", "note": "Finnish adds endings instead of words like to: Turku becomes Turkuun (TUR-koon), to Turku. The audio uses it as the example", "spoken": "Mikä juna menee Turkuun?", "filled": "Mikä juna menee ⟦Turkuun⟧?"},
  "buy-ticket": {"text": "Mistä voin ostaa lipun?", "say": "MIS-tä voin OS-taa LI-pun", "note": "Tickets are mostly bought in the VR app"},
  "two-tickets": {"text": "Kaksi lippua..., kiitos", "say": "KAK-si LIP-pu-a ..., KEE-tos", "note": "The audio uses Turku as the example", "spoken": "Kaksi lippua Turkuun, kiitos", "filled": "Kaksi lippua ⟦Turkuun⟧, kiitos"},
  "trip-length": {"text": "Kauanko matka ... kestää?", "say": "KAU-an-ko MAT-ka ... KES-tää", "note": "The audio uses Turku as the example", "spoken": "Kauanko matka Turkuun kestää?", "filled": "Kauanko matka ⟦Turkuun⟧ kestää?"},

  "delicious": {"text": "Herkullista!", "say": "HER-kul-lis-ta"},
  "allergic": {"text": "Olen allerginen...", "say": "O-len AL-ler-gi-nen ...", "note": "The food takes the ending -lle: pähkinöille (PÄH-ki-nöil-le) nuts, maapähkinöille (MAA-päh-ki-nöil-le) peanuts, kananmunalle (KA-nan-mu-nal-le) eggs. The audio uses nuts", "spoken": "Olen allerginen pähkinöille", "filled": "Olen allerginen ⟦pähkinöille⟧"},
  "love-dish": {"text": "Tämä ruoka on herkullista!", "say": "TÄ-mä RUO-ka on HER-kul-lis-ta", "note": "Literally \"this food is delicious\""},
  "what-called": {"text": "Mikä tämä on?", "say": "MI-kä TÄ-mä on", "note": "Literally \"what is this?\" Point at the dish or item"},
  "table-for-two": {"text": "Pöytä kahdelle, kiitos", "say": "PÖY-tä KAH-del-le, KEE-tos"},
  "menu": {"text": "Saisinko ruokalistan?", "say": "SAI-sin-ko RUO-ka-lis-tan"},
  "recommend": {"text": "Mitä suosittelette?", "say": "MI-tä SUO-sit-te-let-te", "note": "At lunch, look for the lounas, a good-value set meal"},
  "beer": {"text": "Yksi olut, kiitos", "say": "ÜK-si O-lut, KEE-tos", "note": "Stronger drinks are sold at the state shop, Alko"},
  "coffee": {"text": "Kahvi", "say": "KAH-vi", "note": "Finns drink more coffee per person than anyone in the world"},
  "tea": {"text": "Tee", "say": "tee"},
  "water": {"text": "Vesi", "say": "VE-si", "note": "Tap water is excellent and free"},
  "milk": {"text": "Maito", "say": "MAI-to"},
  "sugar": {"text": "Sokeri", "say": "SO-ke-ri"},
  "hot": {"text": "Kuuma", "say": "KOO-ma", "note": "Hot. The sauna, Finland's great gift, is SAU-na"},
  "cold": {"text": "Kylmä", "say": "KÜL-mä"},
  "cheers": {"text": "Kippis!", "say": "KIP-pis"},

  "help": {"text": "Apua!", "say": "A-pu-a", "note": "Shout it. For any emergency, call 112"},
  "need-doctor": {"text": "Tarvitsen lääkärin", "say": "TAR-vit-sen LÄÄ-kä-rin", "note": "For an ambulance, call 112"},
  "pharmacy": {"text": "Missä on apteekki?", "say": "MIS-sä on AP-teek-ki"}
}
