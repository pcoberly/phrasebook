{
  "hello": {"text": "Dobar dan", "say": "DO-bar dan", "note": "Polite, for anyone during the day. Friends say Bok (bok), hi and bye"},
  "how-are-you": {"text": "Kako ste?", "say": "KA-ko steh", "note": "Polite and the same for anyone"},
  "im-well": {"text": "Dobro sam, hvala!", "say": "DOB-ro sam, HVA-la", "note": "The same for a man or a woman"},
  "good-morning": {"text": "Dobro jutro", "say": "DOB-ro YOO-tro"},
  "good-night": {"text": "Laku noć", "say": "LA-koo noch", "note": "Only when parting at night. Good evening is Dobra večer (DOB-ra VEH-cher)"},
  "goodbye": {"text": "Doviđenja", "say": "do-vee-JEN-ya"},
  "please": {"text": "Molim", "say": "MO-leem", "note": "Also means you're welcome and pardon?"},
  "thank-you": {"text": "Hvala", "say": "HVA-la", "note": "Hvala lijepa (lee-YEH-pa) means thank you very much"},
  "youre-welcome": {"text": "Nema na čemu", "say": "NEH-ma na CHEH-moo", "note": "Literally \"there's nothing for it\""},
  "yes": {"text": "Da", "say": "da"},
  "no": {"text": "Ne", "say": "neh"},
  "excuse-me": {"text": "Oprostite", "say": "o-PRO-stee-teh", "note": "Sorry, and excuse me to get attention or get past"},
  "my-name": {"text": "Zovem se...", "say": "ZO-vem seh ...", "note": "Literally \"I call myself\". The audio uses Peter as the example name", "spoken": "Zovem se Peter", "filled": "Zovem se ⟦Peter⟧"},
  "your-name": {"text": "Kako se zovete?", "say": "KA-ko seh ZO-veh-teh", "note": "Polite and the same for anyone"},
  "where-from": {"text": "Odakle ste?", "say": "O-da-kleh steh"},
  "its-beautiful": {"text": "Prekrasno je!", "say": "PREH-kras-no yeh"},
  "dont-understand": {"text": "Ne razumijem", "say": "neh ra-ZOO-mee-yem", "note": "The same for a man or a woman"},
  "speak-slowly": {"text": "Govorite sporije, molim", "say": "go-VO-ree-teh SPO-ree-yeh, MO-leem"},
  "repeat": {"text": "Možete li ponoviti?", "say": "MO-zheh-teh lee po-NO-vee-tee"},
  "speak-english": {"text": "Govorite li engleski?", "say": "go-VO-ree-teh lee EN-gles-kee", "note": "Most people in tourist areas speak English, and many speak German or Italian"},

  "one": {"text": "Jedan", "say": "YEH-dan"},
  "two": {"text": "Dva", "say": "dva"},
  "three": {"text": "Tri", "say": "tree"},
  "four": {"text": "Četiri", "say": "CHEH-tee-ree"},
  "five": {"text": "Pet", "say": "pet"},
  "six": {"text": "Šest", "say": "shest"},
  "seven": {"text": "Sedam", "say": "SEH-dam"},
  "eight": {"text": "Osam", "say": "O-sam"},
  "nine": {"text": "Devet", "say": "DEH-vet"},
  "ten": {"text": "Deset", "say": "DEH-set"},
  "hundred": {"text": "Sto", "say": "sto"},
  "thousand": {"text": "Tisuća", "say": "TEE-soo-cha", "note": "Prices in Croatia are in euros. Serbia uses dinars, and Bosnia convertible marks"},
  "hundred-thousand": {"text": "Sto tisuća", "say": "sto TEE-soo-cha"},
  "million": {"text": "Milijun", "say": "MEE-lee-yoon", "note": "In Serbia and Bosnia, milion (MEE-lee-on)"},

  "how-much": {"text": "Koliko košta?", "say": "KO-lee-ko KOSH-ta"},
  "would-like": {"text": "Mogu li dobiti...?", "say": "MO-goo lee DO-bee-tee ...", "note": "Literally \"may I get...?\", the polite way to order, the same for a man or a woman. The audio uses kavu (KA-voo), a coffee", "spoken": "Mogu li dobiti kavu?", "filled": "Mogu li dobiti ⟦kavu⟧?"},
  "i-want": {"text": "Želim...", "say": "ZHEH-leem ...", "note": "More direct. The audio uses ovo (O-vo), this one", "spoken": "Želim ovo", "filled": "Želim ⟦ovo⟧"},
  "do-you-have": {"text": "Imate li...?", "say": "EE-ma-teh lee ...", "note": "The audio uses vode (VO-deh), water", "spoken": "Imate li vode?", "filled": "Imate li ⟦vode⟧?"},
  "just-looking": {"text": "Samo gledam", "say": "SA-mo GLEH-dam"},
  "ill-take-it": {"text": "Uzet ću to", "say": "OO-zet choo to"},
  "too-expensive": {"text": "Preskupo je", "say": "PREH-skoo-po yeh"},
  "discount": {"text": "Može popust?", "say": "MO-zheh PO-poost", "note": "Literally \"a discount, possible?\" Fine at markets, not in shops"},
  "card": {"text": "Mogu li platiti karticom?", "say": "MO-goo lee PLA-tee-tee KAR-tee-tsom", "note": "Cards work almost everywhere in cities; islands and small konobas may want cash"},
  "bill": {"text": "Račun, molim", "say": "RA-choon, MO-leem", "note": "Rounding up or tipping about 10% is appreciated"},

  "reservation": {"text": "Imam rezervaciju", "say": "EE-mam reh-zer-VA-tsee-yoo"},
  "checkout-time": {"text": "Kada je odjava?", "say": "KA-da yeh OD-ya-va"},
  "breakfast": {"text": "Je li doručak uključen?", "say": "yeh lee DO-roo-chak OOK-lyoo-chen"},
  "wifi": {"text": "Koja je lozinka za wifi?", "say": "KO-ya yeh lo-ZEEN-ka za VAI-fai"},

  "toilet": {"text": "Gdje je WC?", "say": "gdyeh yeh VEH-tseh", "note": "Gdje (gdyeh) means where"},
  "taxi": {"text": "Možete li mi pozvati taksi?", "say": "MO-zheh-teh lee mee POZ-va-tee TAK-see", "note": "Uber and Bolt work in the main cities"},
  "train": {"text": "Vlak", "say": "vlak", "note": "In Serbia and Bosnia, voz (voz)"},
  "bus": {"text": "Autobus", "say": "OW-to-boos", "note": "Buses are the main way to get around; ferries, trajekt (TRA-yekt), reach the islands"},
  "airport": {"text": "Zračna luka", "say": "ZRACH-na LOO-ka", "note": "In Serbia and Bosnia, aerodrom"},
  "bus-station": {"text": "Autobusni kolodvor", "say": "OW-to-boos-nee KO-lod-vor", "note": "In Serbia and Bosnia, autobuska stanica (sta-NEE-tsa)"},
  "train-station": {"text": "Željeznički kolodvor", "say": "ZHEH-lyez-neech-kee KO-lod-vor", "note": "In Serbia and Bosnia, železnička stanica"},
  "where-train-station": {"text": "Gdje je željeznički kolodvor?", "say": "gdyeh yeh ZHEH-lyez-neech-kee KO-lod-vor"},
  "where-bus-station": {"text": "Gdje je autobusni kolodvor?", "say": "gdyeh yeh OW-to-boos-nee KO-lod-vor"},
  "which-train": {"text": "Koji vlak ide za...?", "say": "KO-yee vlak EE-deh za ...", "note": "The audio uses Split as the example", "spoken": "Koji vlak ide za Split?", "filled": "Koji vlak ide za ⟦Split⟧?"},
  "buy-ticket": {"text": "Gdje mogu kupiti kartu?", "say": "gdyeh MO-goo KOO-pee-tee KAR-too"},
  "two-tickets": {"text": "Dvije karte za..., molim", "say": "DVEE-yeh KAR-teh za ..., MO-leem", "note": "The audio uses Split as the example", "spoken": "Dvije karte za Split, molim", "filled": "Dvije karte za ⟦Split⟧, molim"},
  "trip-length": {"text": "Koliko traje put do...?", "say": "KO-lee-ko TRA-yeh poot do ...", "note": "After do (do), to, the place changes its ending: Split becomes Splita. The audio uses Split", "spoken": "Koliko traje put do Splita?", "filled": "Koliko traje put do ⟦Splita⟧?"},

  "delicious": {"text": "Jako ukusno!", "say": "YA-ko OO-koos-no"},
  "allergic": {"text": "Imam alergiju na...", "say": "EE-mam a-LER-gee-yoo na ...", "note": "Literally \"I have an allergy to\", the same for a man or a woman. Add the food: orašaste plodove (O-ra-shas-teh PLO-do-veh) nuts, kikiriki (KEE-kee-ree-kee) peanuts, jaja (YA-ya) eggs. The audio uses nuts", "spoken": "Imam alergiju na orašaste plodove", "filled": "Imam alergiju na ⟦orašaste plodove⟧"},
  "love-dish": {"text": "Ovo jelo je odlično!", "say": "O-vo YEH-lo yeh OD-leech-no", "note": "Literally \"this dish is excellent\""},
  "what-called": {"text": "Kako se ovo zove?", "say": "KA-ko seh O-vo ZO-veh", "note": "Point at the dish or item"},
  "table-for-two": {"text": "Stol za dvoje, molim", "say": "stol za DVO-yeh, MO-leem"},
  "menu": {"text": "Jelovnik, molim", "say": "YEH-lov-neek, MO-leem"},
  "recommend": {"text": "Što preporučujete?", "say": "shto preh-po-roo-CHOO-yeh-teh", "note": "On the coast, try grilled fish and black risotto; inland, ćevapi"},
  "beer": {"text": "Jedno pivo, molim", "say": "YED-no PEE-vo, MO-leem"},
  "coffee": {"text": "Kava", "say": "KA-va", "note": "Coffee is a social ritual: one cup can last an hour on a terrace"},
  "tea": {"text": "Čaj", "say": "chai"},
  "water": {"text": "Voda", "say": "VO-da", "note": "Tap water is safe"},
  "milk": {"text": "Mlijeko", "say": "MLEE-yeh-ko", "note": "In Serbia, mleko (MLEH-ko)"},
  "sugar": {"text": "Šećer", "say": "SHEH-cher"},
  "hot": {"text": "Vruće", "say": "VROO-cheh"},
  "cold": {"text": "Hladno", "say": "HLAD-no"},
  "cheers": {"text": "Živjeli!", "say": "ZHEEV-yeh-lee", "note": "Literally \"may we live!\" Look each person in the eye"},

  "help": {"text": "Upomoć!", "say": "OO-po-moch", "note": "Shout it. For any emergency, call 112"},
  "need-doctor": {"text": "Trebam liječnika", "say": "TREH-bam lee-YECH-nee-ka", "note": "The same for a man or a woman. For an ambulance, call 194 or 112"},
  "pharmacy": {"text": "Gdje je ljekarna?", "say": "gdyeh yeh LYEH-kar-na", "note": "In Serbia and Bosnia, apoteka (a-po-TEH-ka)"}
