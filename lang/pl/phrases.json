  "trip-length": {"text": "Ile trwa podróż do...?", "say": "EE-leh trfa PO-droozh do ...", "note": "The audio uses Kraków as the example", "spoken": "Ile trwa podróż do Krakowa?", "filled": "Ile trwa podróż do ⟦Krakowa⟧?"},
